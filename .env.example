# Required
OPENAI_API_KEY=sk-proj-...
TAVILY_API_KEY=tvly-...

# Optional tunables (defaults shown)
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
MAX_RESEARCH_LOOPS=3
NUM_QUESTIONS=5
MAX_TOOL_CALLS_PER_QUESTION=2
# USD per 1M tokens, JSON. Unset = built-in table for gpt-4o-mini and gpt-4o.
# MODEL_PRICES={"gpt-4o-mini": {"input": 0.15, "output": 0.6}}
